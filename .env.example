COMMAND_GO_POOL_HOST=127.0.0.1
COMMAND_GO_POOL_PORT=8787
# Optional. Unset leaves inference open. Generate with `command-go-pool rotate` or Settings.
COMMAND_GO_POOL_API_KEY=
# Optional. Locks the dashboard UI. Env only — not stored in config.yaml.
COMMAND_GO_POOL_DASHBOARD_PASSWORD=
COMMAND_GO_POOL_MASTER_KEY=
COMMAND_GO_POOL_LOG_LEVEL=info
COMMAND_GO_POOL_HOME=
# Path written by Connect / setup opencode. In Docker, point this at a volume
# shared with the OpenCode container (see docker-compose.yml).
OPENCODE_CONFIG=
