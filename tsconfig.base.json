{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@command-go-pool/shared": ["./packages/shared/src/index.ts"],
      "@command-go-pool/storage": ["./packages/storage/src/index.ts"],
      "@command-go-pool/observability": ["./packages/observability/src/index.ts"],
      "@command-go-pool/transport-commandcode": ["./packages/transport-commandcode/src/index.ts"],
      "@command-go-pool/protocol-openai": ["./packages/protocol-openai/src/index.ts"],
      "@command-go-pool/protocol-anthropic": ["./packages/protocol-anthropic/src/index.ts"],
      "@command-go-pool/account-pool": ["./packages/account-pool/src/index.ts"],
      "@command-go-pool/session-router": ["./packages/session-router/src/index.ts"],
      "@command-go-pool/quota-engine": ["./packages/quota-engine/src/index.ts"],
      "@command-go-pool/server": ["./packages/server/src/index.ts"]
    }
  }
}
