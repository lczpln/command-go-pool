{
  "name": "command-go-pool",
  "version": "0.1.1",
  "description": "Local inference gateway that pools user-owned Command Code Go subscriptions into one sticky, quota-aware endpoint.",
  "type": "module",
  "bin": {
    "command-go-pool": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx packages/cli/src/index.ts",
    "dev:dashboard": "npm run dev -w @command-go-pool/dashboard",
    "build": "rm -rf dist && npm run build:dashboard && npm run build:cli && mkdir -p dist/dashboard && cp -R apps/dashboard/dist/. dist/dashboard/ && chmod +x dist/cli.js",
    "build:cli": "tsup --config tsup.config.ts",
    "build:dashboard": "npm run build -w @command-go-pool/dashboard",
    "prepack": "npm run build",
    "pack:check": "node scripts/pack-check.mjs",
    "demo": "tsx examples/demo-mock.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b --pretty false"
  },
  "keywords": [
    "command-code",
    "pool",
    "openai",
    "anthropic",
    "opencode"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lczpln/command-go-pool.git"
  },
  "bugs": {
    "url": "https://github.com/lczpln/command-go-pool/issues"
  },
  "homepage": "https://github.com/lczpln/command-go-pool#readme",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@fastify/static": "^8.2.0",
    "@inquirer/prompts": "^7.8.0",
    "better-sqlite3": "^12.2.0",
    "commander": "^14.0.0",
    "fastify": "^5.5.0",
    "js-yaml": "^4.1.0",
    "pino": "^9.9.0",
    "pino-pretty": "^13.1.1",
    "yaml": "^2.8.1",
    "zod": "^3.25.76"
  },
  "optionalDependencies": {
    "keytar": "^7.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
